<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="#173A2C"
    android:padding="12dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
  <TextView
      android:id="@+id/widget_name"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:maxLines="1"
      android:ellipsize="end"
      android:text="Rolling Local"
      android:textStyle="bold"
      android:textColor="#FFFFFF"
      android:textSize="15sp" />
  <TextView
      android:id="@+id/widget_status"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:maxLines="2"
      android:text="Offline"
      android:textColor="#C5E9D7"
      android:textSize="13sp" />
  <LinearLayout
      android:orientation="horizontal"
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:gravity="bottom">
    <ImageButton
        android:id="@+id/widget_toggle"
        android:layout_width="0dp"
        android:layout_height="42dp"
        android:layout_weight="1"
        android:background="#367358"
        android:src="@android:drawable/ic_lock_power_off"
        android:contentDescription="Toggle location sharing" />
    <ImageButton
        android:id="@+id/widget_camera"
        android:layout_width="0dp"
        android:layout_height="42dp"
        android:layout_weight="1"
        android:layout_marginStart="6dp"
        android:background="#367358"
        android:src="@android:drawable/ic_menu_camera"
        android:contentDescription="Open menu camera" />
  </LinearLayout>
</LinearLayout>
